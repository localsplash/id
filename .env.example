# The .env carries three things: where the settings store is, the token to
# read it with, and the one network that is trusted. Everything else —
# including the MySQL coordinates — is a row in the NocoDB `oAuthConfig`
# table, so a deployment is described in one place. See README.md.
#
# Zero-config is the intended path: a fresh instance is expected at
# identity.X.TLD and needs nothing beyond what is below. APP_BASE_URL in
# particular is deliberately absent — leave it unset and the public base URL
# is the URL the browser actually reached this service on, which the setup
# wizard then writes to oAuthConfig for you.

PORT=3200

# ── The settings store (NocoDB at nocodb.<parent-domain>) ────────────────────
# Generate the API token in the NocoDB UI: Account → Tokens.
NOCODB_BASE_URL=http://nocodb:8080
NOCODB_API_TOKEN=generate-in-nocodb-ui

# ── The trusted network ──────────────────────────────────────────────────────
# One IPv4 CIDR: the network the platform's servers sit on (/32 allowed, a
# bare IP treated as /32). It describes a network, not an application —
# every first-party app calling from inside it may use the server-only
# endpoints (/api/token, /api/apps/register, /api/events, /api/directory/*),
# and nothing outside it may. REQUIRED in production unless
# ID_APP_AUTH_MODE=secret; startup fails otherwise. IPv6 is never trusted.
# A comma-separated list is still parsed, for servers that genuinely
# straddle two ranges.
ID_TRUSTED_NETWORK=10.9.0.0/16

# How applications authenticate to those endpoints:
#   cidr   — POC default: the caller's IPv4 peer must be in ID_TRUSTED_NETWORK
#   secret — legacy ID_CLIENT_SECRET check only (pre-rollout behaviour)
#   dual   — either is accepted (short migration window)
ID_APP_AUTH_MODE=cidr

# Optional. Comma-separated IPv4 CIDRs of reverse proxies that connect
# directly to this app. X-Forwarded-For is honoured ONLY when the socket
# peer is in this list; leave empty when apps reach id directly.
ID_TRUSTED_PROXY_CIDRS=

# ── Optional: pin an oAuthConfig setting here ────────────────────────────────
# Any key from the oAuthConfig table may also be set in this file, where it
# OVERRIDES the stored row: it is read-only in /admin, is never copied into
# the store, and takes a restart to change. Blank counts as unset. This is
# an override for deployments that manage configuration as environment — the
# zero-config path leaves all of it commented out and fills the rows in
# NocoDB (or, for everything but the database, through the setup wizard).
#
# The identity database — id_db, which this app owns and migrates itself.
# Set these here or in NocoDB before first run; nothing else works without
# them, and a change takes a restart.
# DB_HOST=mysql.internal
# DB_PORT=3306
# DB_USER=id_app
# DB_PASSWORD=
# DB_NAME=id_db
#
# APP_BASE_URL=https://identity.example.com
# PARENT_DOMAIN=example.com
# SUPERADMIN_DOMAIN=example.com
# DEFAULT_REDIRECT_URI=https://echo.example.com/auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
