# Everything else — OAuth client credentials, UISP integration, public URLs —
# lives in the NocoDB `oAuthConfig` table, NOT here. See README.md.

PORT=3200

# MySQL (identity tables)
DB_HOST=echo-database
DB_PORT=3306
DB_USER=echo_app
DB_PASSWORD=change-me
DB_NAME=id_db

# NocoDB settings store (the instance at nocodb.<parent-domain>)
NOCODB_BASE_URL=http://nocodb:8080
NOCODB_API_TOKEN=generate-in-nocodb-ui
# AidaOffice is shared with the other Aida projects; NOCODB_TABLE_NAME is what
# distinguishes this project's data inside it. Getting the base name wrong
# creates a second, empty base rather than failing, so the app logs loudly when
# it creates one — see the warning in src/settings.ts.
NOCODB_BASE_NAME=AidaOffice
NOCODB_TABLE_NAME=oAuthConfig

# Aida service-to-service authentication.
# This service signs its calls to other Aida services with this key and
# publishes the matching public key to `aida_application` in the shared base.
# Base64 of the PKCS#8 DER, one line. Generate with: npm run keygen
# Required in production — the process refuses to start without it. In
# development an ephemeral key is generated with a warning.
# It is unrelated to user sessions: changing it signs nobody out.
AIDA_APP_PRIVATE_KEY=
# Registry identity is (application_name, environment), never a hostname.
# AIDA_ENVIRONMENT defaults to NODE_ENV; set it when you have more
# environments than Node has names for (staging, say).
AIDA_APP_NAME=id
AIDA_ENVIRONMENT=
