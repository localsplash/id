# The .env carries two things: where the settings store is, and the token to
# read it with. Everything else — the identity database coordinates, the
# trusted network, the public URL, the OAuth credentials — is a row in the
# `auth_tbl_Settings` table of the `IdentityBase` base in NocoDB.
#
# The base is found by NAME at runtime, never by a base ID in a file: a
# pasted ID survives a rename and outlives a restore. The name is expected to
# be unique — NocoDB does not enforce that, we do — and two bases sharing it
# is an error this app refuses to guess its way past.
#
# Zero-config is the intended path: a fresh instance is expected at
# identity.X.TLD and needs nothing beyond the two variables below. The
# first-run wizard collects the database coordinates and the OAuth
# credentials, and writes the public base URL from the address you open it on.

PORT=3200

# ── The settings store (NocoDB at nocodb.X.TLD) ──────────────────────────────
# Generate the API token in the NocoDB UI: Account → Tokens. If either of
# these is missing, or no base named IdentityBase exists, the app retries
# once at startup and then exits saying so — there is no fallback.
NOCODB_BASE_URL=http://nocodb:8080
NOCODB_API_TOKEN=generate-in-nocodb-ui

# ── Optional: pin a setting here ─────────────────────────────────────────────
# Any key from auth_tbl_Settings may also be set in this file, where it
# OVERRIDES the stored row: it is read-only in /admin, is never copied into
# the store, and takes a restart to change. Blank counts as unset. This is an
# override for deployments that manage configuration as environment — the
# zero-config path leaves all of it commented out.
#
# The trusted network. ONE value for the whole platform, normally the
# `trustedCIDR` row in auth_tbl_Settings that every application reads.
# IDENTITY_TRUSTED_NETWORK=10.9.0.0/16
#
# Reverse proxies that connect directly to this app. X-Forwarded-For is
# honoured only when the socket peer is in this list; leave empty when
# applications reach this service directly.
# IDENTITY_TRUSTED_PROXY_CIDRS=
#
# How applications authenticate to the server-only endpoints:
#   cidr   — POC default: the caller's IPv4 peer must be inside trustedCIDR
#   secret — legacy IDENTITY_CLIENT_SECRET check only (pre-rollout behaviour)
#   dual   — either is accepted (short migration window)
# IDENTITY_APP_AUTH_MODE=cidr
#
# The identity database — normally collected by the first-run wizard.
# DB_HOST=mysql.internal
# DB_PORT=3306
# DB_USER=identity_app
# DB_PASSWORD=
# DB_NAME=identity_db
#
# APP_BASE_URL=https://identity.example.com
# PARENT_DOMAIN=example.com
# SUPERADMIN_DOMAIN=example.com
# DEFAULT_REDIRECT_URI=https://echo.example.com/auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
