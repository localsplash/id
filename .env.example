# Everything else — OAuth client credentials, UISP integration, public URLs —
# lives in the NocoDB `oAuthConfig` table, NOT here. See README.md.
#
# Zero-config is the intended path: a fresh instance is expected at
# identity.X.TLD and needs nothing below beyond how to reach its two stores.
# APP_BASE_URL in particular is deliberately absent — leave it unset and the
# public base URL is the URL the browser actually reached this service on,
# which the setup wizard then writes to oAuthConfig for you.
#
# Local development (docker-compose) uses a disposable MySQL; production is
# the shared id_db on LSAidaOffice01, which this app owns and migrates
# itself at boot. See "Storage" in README.md.

PORT=3200

# MySQL (id_db — the shared platform identity database)
# Local Docker example shown; production points at the LSAidaOffice01 MySQL.
DB_HOST=id-database
DB_PORT=3306
DB_USER=echo_app
DB_PASSWORD=change-me
DB_NAME=id_db

# NocoDB settings store (the instance at nocodb.<parent-domain>)
NOCODB_BASE_URL=http://nocodb:8080
NOCODB_API_TOKEN=generate-in-nocodb-ui
NOCODB_BASE_NAME=id
NOCODB_TABLE_NAME=oAuthConfig

# ── Server-to-server trust (POC: IPv4/CIDR network policy) ───────────────────
# How applications authenticate to /api/token, /api/apps/register,
# /api/events, and /api/directory/*:
#   cidr   — POC default: caller's IPv4 peer must be in ID_TRUSTED_APP_CIDRS
#   secret — legacy ID_CLIENT_SECRET check only (pre-rollout behaviour)
#   dual   — either is accepted (short migration window)
ID_APP_AUTH_MODE=cidr

# Comma-separated IPv4 CIDRs of the application servers ( /32 and bare IPs
# allowed). REQUIRED in production unless ID_APP_AUTH_MODE=secret — startup
# fails otherwise. IPv6 is never trusted.
ID_TRUSTED_APP_CIDRS=203.0.113.7/32,10.9.0.0/16

# Comma-separated IPv4 CIDRs of reverse proxies that connect directly to
# this app. X-Forwarded-For is honoured ONLY when the socket peer is in
# this list; leave empty when apps reach id directly.
ID_TRUSTED_PROXY_CIDRS=

# ── Optional: pin an oAuthConfig setting here ────────────────────────────────
# Any key from the oAuthConfig table may also be set in this file, where it
# OVERRIDES the stored row: it is read-only in /admin, is never copied into
# the store, and takes a restart to change. Blank counts as unset. This is
# an override for deployments that manage configuration as environment — the
# zero-config path leaves all of it commented out.
#
# APP_BASE_URL=https://identity.example.com
# PARENT_DOMAIN=example.com
# SUPERADMIN_DOMAIN=example.com
# DEFAULT_REDIRECT_URI=https://echo.example.com/auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
